# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Get from @BotFather on Telegram (send /newbot)
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token

# Optional for this build — only needed once storage.py is wired in
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

CLAUDE_MODEL=claude-sonnet-4-6

# --- PII field encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to skip encryption — NOT safe for production.
FIELD_ENCRYPTION_KEY=

# --- Email notifications (SMTP) ---
# Works with Gmail, Outlook, Zoho, or any SMTP provider.
# For Gmail: enable "App Passwords" and use that as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=CreditBot

# --- WhatsApp notifications (Meta Cloud API) ---
# Get credentials from developers.facebook.com → Your App → WhatsApp → API Setup
# Leave blank to skip WhatsApp (channel is silently bypassed in the fallback chain)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Optional: approved template name for messages outside the 24-hour session window
# Example: WHATSAPP_TEMPLATE=credit_update
WHATSAPP_TEMPLATE=

# --- SMS notifications (Africa's Talking) ---
# Sign up at https://africastalking.com — use "sandbox" as username for testing
AT_USERNAME=sandbox
AT_API_KEY=your-at-api-key
# Optional: alphanumeric sender name shown on SMS (requires AT approval)
AT_SENDER_ID=CreditBot

# --- Security ---
# Max application sessions a single user can start per hour (default 3)
RATE_LIMIT_MAX_SESSIONS=3
# Session inactivity timeout in seconds — expired sessions cannot be resumed (default 1800 = 30 min)
SESSION_TIMEOUT_SECONDS=1800

# --- Officer routing ---
# Fallback chat ID: receives reports when no officer code is matched.
# Set to a team group chat so no application is silently lost.
# (Get your chat ID by messaging @userinfobot on Telegram)
DEFAULT_OFFICER_CHAT_ID=

# JSON map: officer code -> Telegram chat ID (the officer's personal user ID
# or a private group they manage). Add one entry per officer.
# Each officer's invite link: https://t.me/<BotUsername>?start=<officer_code>
# Example:
OFFICER_MAP={"OFC001": 123456789, "OFC002": 987654321}
